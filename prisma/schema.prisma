// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id         Int              @id @default(autoincrement())
  name       String
  email      String           @unique
  department String?
  level      String?
  session    String?
  password   String           @default("password123")
  payments   StudentPayment[]
  tickets    Ticket[]
  createdAt  DateTime         @default(now())
}

model StudentCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
}

model PaymentCategory {
  id              Int              @id @default(autoincrement())
  title           String
  description     String?
  amount          Float
  paymentType     String           // e.g., School Fees, Acceptance Fee
  academicSession String
  semester        String?
  department      String?
  level           String?
  isCompulsory    Boolean          @default(true)
  dueDate         DateTime?
  status          String           @default("active") // active, inactive, archived
  createdAt       DateTime         @default(now())
  payments        StudentPayment[]
}

model StudentPayment {
  id                Int             @id @default(autoincrement())
  studentId         Int
  paymentCategoryId Int
  amountPaid        Float           @default(0)
  balanceRemaining  Float
  status            String          @default("unpaid") // unpaid, pending, partially_paid, paid, overdue
  reference         String?         @unique
  paidAt            DateTime?
  createdAt         DateTime        @default(now())

  student         Student         @relation(fields: [studentId], references: [id])
  paymentCategory PaymentCategory @relation(fields: [paymentCategoryId], references: [id])
  tickets         Ticket[]
}
model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // In a real app, hash this!
  name      String?
  createdAt DateTime @default(now())
}

model Ticket {
  id               Int             @id @default(autoincrement())
  studentId        Int
  studentPaymentId Int?            // Optional link to a specific payment
  subject          String
  message          String
  status           String          @default("open") // open, resolved
  createdAt        DateTime        @default(now())

  student          Student         @relation(fields: [studentId], references: [id])
  payment          StudentPayment? @relation(fields: [studentPaymentId], references: [id])
}
